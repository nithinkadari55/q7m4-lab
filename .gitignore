# Public checkout: opt in reviewed source paths only.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/LICENSE-*
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/.github/
!/src/
!/crates/
!/tests/
!/examples/

# Build outputs, private configuration, local evidence and downloaded material.
**/target/
**/.tools/
**/.cargo/
**/.rustup/
**/.env
**/.env.*
**/results/
**/evidence/
**/raw/
**/downloads/
**/node_modules/
**/__pycache__/
**/*.log
**/*.jsonl
**/*.sqlite
**/*.sqlite-*
**/*.db
**/*.db-*
**/*.xlsx
**/*.xlsm
**/*.xlsb
**/*.xls
**/*.xlam
**/*.exe
**/*.dll
**/*.pdb
**/*.zip
**/*.7z
**/*.tar
**/*.gz
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/credentials*
**/secrets*
